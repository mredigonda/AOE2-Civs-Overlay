{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "AoE2 Civs Overlay",
    "version": "2.0.0",
    "identifier": "com.maxredigonda.aoe2-civs-overlay",
    "build": {
        "frontendDist": "../ui"
    },
    "app": {
        "macOSPrivateApi": true,
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "AoE2 Civs Overlay",
                "width": 420,
                "height": 120,
                "x": 40,
                "y": 80,
                "decorations": false,
                "transparent": true,
                "shadow": false,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "resizable": false,
                "visibleOnAllWorkspaces": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "createUpdaterArtifacts": true,
        "shortDescription": "Age of Empires II civ overlay",
        "longDescription": "Always-on-top overlay with your civ's and your rival's bonuses, unique units and tech tree gaps for Age of Empires II: Definitive Edition.",
        "category": "Utility",
        "homepage": "https://mredigonda.github.io/AOE2-Civs-Overlay/",
        "macOS": {
            "signingIdentity": "-"
        },
        "windows": {
            "nsis": {
                "installMode": "currentUser"
            }
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0NDgyQTEyODBCQjJDMTAKUldRUUxMdUFFaXBJcE5Pd3djZHo5SzkyeXp0RllHVGlVeGJqNVhtUllZZ0kvaWxnYWRGbEcvMVcK",
            "endpoints": [
                "https://github.com/mredigonda/AOE2-Civs-Overlay/releases/latest/download/latest.json"
            ]
        }
    }
}
