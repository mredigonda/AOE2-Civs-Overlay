{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "AoE2 Civs Overlay",
    "version": "2.0.0",
    "identifier": "com.maxredigonda.aoe2-civs-overlay",
    "build": {
        "frontendDist": "../ui"
    },
    "app": {
        "macOSPrivateApi": true,
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "AoE2 Civs Overlay",
                "width": 420,
                "height": 120,
                "x": 40,
                "y": 80,
                "decorations": false,
                "transparent": true,
                "shadow": false,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "resizable": false,
                "visibleOnAllWorkspaces": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
